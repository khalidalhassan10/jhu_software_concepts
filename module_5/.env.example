# Copy this file to .env (which is never committed) and put the real values in .env.
# The app uses DATABASE_URL if it is set; otherwise it builds the URL from these five.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradcafe
DB_USER=gradcafe_app
DB_PASSWORD=change-me

# The tests use their own throwaway database, as the owner (they empty the table).
TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/gradcafe_test